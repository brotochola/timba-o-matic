  "letra": {
   "cuerpo": [
    "Me dices que baje la voz, que la noche es larga, / que el que corre mucho se cansa y no llega a nada.",
    "Pero tú no ves la orquesta cómo está prendida, / y el piano que me llama dando vueltas a la vida."
   ],
   "puente": "Yo no sé estar quieto… yo no sé esperar…",
   "coro": "No me pidas calma, que la timba está en el alma",
   "presion": "¡Ahí na’ má’! — la gente para y la clave sola",
   "despelote": "¡Suéltate, suéltate! Que se suelte todo el mundo",
   "bomba": "¡Bomba! Pa’l piso, pa’l piso…",
   "pregones": [
    "Calma tiene el que no baila",
    "Si me quedo quieto me da una cosa en el pie",
    "Ni el reloj ni la policía"
   ]
  }
