  "letra": {
   "cuerpo": [
    "En la esquina del barrio se juntaban los de siempre, / con la radio en la ventana y el sol pegando de frente.",
    "Uno tocaba la lata, otro cantaba un bolero, / y la vieja desde el quinto gritaba: «¡suban el pandero!»"
   ],
   "coro": "Esquina del barrio, ahí nació mi son",
   "pregones": [
    "De la 110 a la 116, la misma clave",
    "Que lo diga el timbalero, que estuvo ahí",
    "Cuando la campana suena, nadie se va pa’ la casa"
   ],
   "mona": "(los metales tiran la moña y el coro contesta)"
  }
