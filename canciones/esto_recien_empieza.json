  "letra": {
   "intro": "(el piano solo, con la clave; el timbal redobla y entra la banda con los metales)",
   "cuerpo": [
    "Primero entró el piano, solito, buscando la clave; / después llegó el bajo, caminando como el que sabe.",
    "Las congas lo siguieron, el güiro pidió permiso, / y la noche se fue armando de a poquito, sin aviso."
   ],
   "cuerpo2": [
    "Vos que llegaste tarde y te quedaste en la puerta, / pasá, que acá se baila con la ventana abierta.",
    "No mires el reloj, que el reloj no sabe nada: / la noche es del que baila y la clave no se apaga."
   ],
   "puente": "¿Y te vas a ir ahora? ¿Ahora, que se puso linda? ¡Escuchá!",
   "coro": "Quedate, que esto recién empieza",
   "pregones": [
    "Prendé la luz, que llegó la orquesta",
    "El piano llama y el tambor le contesta",
    "Si te vas ahora te perdés lo mejor",
    "Abrí la puerta, que la timba no se cierra",
    "Mirá cómo suben los metales"
   ],
   "presion": "¡Apretá, apretá! Que la clave no se suelta (y el coro sigue: «quedate…»)",
   "bomba": "¡Bomba! ¡Para abajo, para abajo!",
   "despelote": "¡Ahora sí! ¡Que se suelte todo el mundo!",
   "muela": "(hablado) ¿Y? ¿Ya se cansaron? No, no, no… acá nadie se va. A ver ese trombón… ¡dale!",
   "corofinal": "Quedate, que esto recién empieza (y los metales de a uno: el trombón, el saxo, las trompetas)",
   "final": "¡Y esto… recién empieza!"
  }
 },
